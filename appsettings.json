{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost;Persist Security Info=True;User ID={DB_USER};Password={DB_PASSWORD};Database={DB_NAME};Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;"
  }
}
